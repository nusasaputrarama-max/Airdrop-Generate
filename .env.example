# AIRDROP GENERATE — .env.example
# Salin ke .env.local dan isi dengan nilai ASLI dari pemilik.
# JANGAN PERNAH commit .env.local. File ini hanya berisi placeholder.
# Tidak ada kredensial nyata di paket ini.

# Supabase (dibutuhkan saat M2 — migrasi database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service-role key HANYA untuk server / migrasi — tidak pernah di frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Umum
NODE_ENV=development
