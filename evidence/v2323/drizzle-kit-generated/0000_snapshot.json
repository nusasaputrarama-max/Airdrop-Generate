        "contract_address_canonical": {
          "name": "contract_address_canonical",
          "type": "text",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false,
          "generated": {
            "as": "(CASE\n        WHEN \"contract_address\" IS NULL THEN NULL\n        WHEN \"chain\" = 'Solana' THEN trim(\"contract_address\")\n        WHEN \"chain\" IN ('BNB Chain','Ethereum','Base','Arbitrum','Polygon','opBNB','Robinhood Chain') THEN\n          CASE WHEN lower(substr(trim(\"contract_address\"),1,2)) = '0x'\n               THEN '0x' || lower(substr(trim(\"contract_address\"),3))\n               ELSE '0x' || lower(trim(\"contract_address\")) END\n        ELSE NULL\n      END)",
